---
import { categoryHue } from '../lib/categoryHue.ts';

interface RunSummary { time: string; categories: string[]; }
interface DayIndex { date: string; runs: RunSummary[]; }

interface Props {
  index: DayIndex[];
}
const { index } = Astro.props;

const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
function weekdayOf(dateStr: string): string {
  const [y, m, d] = dateStr.split('-').map(Number);
  return WEEKDAYS[new Date(Date.UTC(y, m - 1, d)).getUTCDay()];
}
function latestTime(day: DayIndex): string {
  return day.runs.reduce((max, r) => (r.time > max ? r.time : max), day.runs[0].time);
}
function unionCatsOf(day: DayIndex): string[] {
  const s = new Set<string>();
  for (const r of day.runs) for (const c of r.categories) s.add(c);
  return Array.from(s);
}

const dayMeta: Record<string, { weekday: string; runs: number; cats: number; latest: string }> = {};
const yearsSet = new Set<string>();
const monthsSet = new Set<string>();
const catsSet = new Set<string>();
let totalRuns = 0;
for (const day of index) {
  dayMeta[day.date] = {
    weekday: weekdayOf(day.date),
    runs: day.runs.length,
    cats: unionCatsOf(day).length,
    latest: latestTime(day),
  };
  yearsSet.add(day.date.slice(0, 4));
  monthsSet.add(day.date.slice(0, 7));
  totalRuns += day.runs.length;
  for (const r of day.runs) for (const c of r.categories) catsSet.add(c);
}
const years = Array.from(yearsSet).sort((a, b) => (a < b ? 1 : -1));
const months = Array.from(monthsSet).sort((a, b) => (a < b ? 1 : -1));
const cats = Array.from(catsSet).sort((a, b) => a.localeCompare(b));
const totalDays = index.length;
const totalCats = cats.length;
const spanStart = index.length ? index.reduce((min, d) => (d.date < min ? d.date : min), index[0].date) : '';
const spanEnd = index.length ? index.reduce((max, d) => (d.date > max ? d.date : max), index[0].date) : '';

const monthsByYear: Record<string, string[]> = {};
for (const m of months) {
  const y = m.slice(0, 4);
  if (!monthsByYear[y]) monthsByYear[y] = [];
  monthsByYear[y].push(m);
}

const statsLine = `${totalDays} 天 · ${totalRuns} 次 run · ${totalCats} 類別` + (spanStart ? ` · ${spanStart} → ${spanEnd}` : '');

const serializedIndex = JSON.stringify(index);
const serializedCats = JSON.stringify(cats.map((c) => ({ name: c, hue: categoryHue(c) })));
const serializedMeta = JSON.stringify(dayMeta);
const serializedYears = JSON.stringify(years);
const serializedMonthsByYear = JSON.stringify(monthsByYear);
const serializedWeekdays = JSON.stringify(WEEKDAYS);
const defaultYear = years[0] || '';
---

<section class="archive" data-archive>
  <header class="archive-head">
    <span class="classification">Archive</span>
    <h2 class="archive-title">每日簡報檔案</h2>
    <p class="archive-stats mono">{statsLine}</p>
  </header>

  <div class="archive-controls">
    <div class="search-row">
      <input
        type="search"
        class="archive-search"
        placeholder="搜尋日期或類別…（Cmd/Ctrl+K）"
        aria-label="搜尋檔案"
        data-archive-search
      />
      <span class="result-count mono" data-result-count aria-live="polite"></span>
    </div>
    {years.length > 1 && (
      <div class="pill-row" data-year-pills role="group" aria-label="年份">
        {years.map((y) => (
          <button class="pill" type="button" data-year={y} aria-pressed="false">{y}</button>
        ))}
      </div>
    )}
    <div class="pill-row" data-month-pills role="group" aria-label="月份"></div>
    <div class="pill-row" data-cat-pills role="group" aria-label="類別">
      <button class="pill is-active" type="button" data-cat="" aria-pressed="true">全部</button>
      {cats.map((c) => (
        <button class="pill" type="button" data-cat={c} aria-pressed="false" style={`--h: ${categoryHue(c)}`}>
          <span class="cat-dot" style={`--h: ${categoryHue(c)}`} aria-hidden="true"></span>
          {c}
        </button>
      ))}
    </div>
  </div>

  <div class="day-detail" data-day-detail hidden></div>

  <div class="no-results" data-no-results hidden>
    <p>沒有符合的結果。</p>
    <button class="btn" type="button" data-clear-filters>清除篩選</button>
  </div>

  <div class="archive-body" data-archive-body></div>
</section>

<style>
  .archive {
    margin-top: 56px;
    padding-top: 36px;
    border-top: 1px solid var(--border);
  }
  .archive-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 22px;
  }
  .classification {
    display: inline-block;
    width: fit-content;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--r-pill);
    padding: 2px 10px;
  }
  .archive-title {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 700;
  }
  .archive-stats {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .archive-controls { display: grid; gap: 14px; margin-bottom: 24px; }
  .search-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .archive-search {
    flex: 1 1 240px;
    min-width: 180px;
    padding: 10px 16px;
    border-radius: var(--r-input);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 0.9rem;
  }
  .archive-search:focus { outline: none; border-color: var(--accent); }
  .result-count { font-size: 0.78rem; color: var(--text-muted); white-space: nowrap; }
  .pill-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .archive .pill {
    padding: 8px 16px;
    min-height: 40px;
    gap: 7px;
    font-size: 0.86rem;
  }

  .day-detail {
    display: grid;
    gap: 12px;
    padding: 16px 18px;
    margin-bottom: 24px;
    border: 1px solid var(--accent);
    border-radius: var(--r-card);
    background: var(--accent-soft);
  }
  .day-detail-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .day-detail-date {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }
  .day-detail-date .dd-num {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
  }
  .day-detail-date .dd-wd {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .day-detail-runs {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .day-detail-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .day-detail-go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: 0.85rem;
    text-decoration: none;
    padding: 4px 10px;
    border-radius: var(--r-input);
    border: 1px solid var(--accent);
    width: fit-content;
  }
  .day-detail-go:hover { background: var(--accent); color: var(--bg); text-decoration: none; }

  .no-results {
    text-align: center;
    padding: 32px 16px;
    color: var(--text-muted);
    border: 1px dashed var(--border);
    border-radius: var(--r-card);
  }
  .no-results p { margin: 0 0 12px; }

  .archive-body { display: grid; gap: 24px; }

  .month-section {
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    background: var(--bg-elevated);
    overflow: hidden;
  }
  .month-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    cursor: pointer;
    user-select: none;
    background: var(--bg-sunken);
  }
  .month-head-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .month-chevron {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    color: var(--text-muted);
    transition: transform 0.2s ease;
    line-height: 1;
  }
  .month-section.is-open .month-chevron { transform: rotate(0deg); }
  .month-section:not(.is-open) .month-chevron { transform: rotate(-90deg); }
  .month-section.force-open .month-chevron { display: none; }
  .month-label {
    margin: 0;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text);
  }
  .month-count {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.74rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .month-body {
    display: grid;
    gap: 10px;
    padding: 14px 16px 18px;
  }
  .month-section:not(.is-open) .month-body { display: none; }

  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  .cal-dow {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: center;
    padding: 4px 0 6px;
  }
  .cal-cell {
    min-height: 44px;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 5px 7px;
    border-radius: var(--r-input);
    border: 1px solid transparent;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: transparent;
  }
  .cal-cell.cal-blank { border-color: transparent; background: transparent; }
  .cal-cell.cal-empty { color: var(--text-muted); opacity: 0.35; }
  .cal-cell.has-data {
    color: var(--text);
    background: var(--bg-sunken);
    border-color: var(--border);
    cursor: pointer;
    position: relative;
  }
  .cal-cell.has-data:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .cal-cell.has-data.filtered-out {
    opacity: 0.3;
  }
  .cal-cell.is-selected {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }
  .cal-cell.is-selected .cal-dot { background: var(--bg); }
  .cal-dot {
    position: absolute;
    bottom: 4px;
    left: 6px;
    width: 5px;
    height: 5px;
    border-radius: var(--r-pill);
    background: var(--accent);
  }
  .cal-runs {
    position: absolute;
    top: 4px;
    left: 6px;
    font-size: 0.58rem;
    color: var(--text-muted);
    line-height: 1;
  }
  .cal-cell.is-selected .cal-runs { color: var(--bg); }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 11px;
    border-radius: var(--r-pill);
    border: 1px solid hsl(var(--h) var(--cat-s) var(--cat-l));
    color: hsl(var(--h) var(--cat-s) var(--cat-l));
    background: transparent;
    font-size: 0.78rem;
    text-decoration: none;
    min-height: 28px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .chip:hover {
    background: hsl(var(--h) var(--cat-s) var(--cat-l));
    color: var(--bg);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .pill-row {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: thin;
    }
    .pill { flex-shrink: 0; min-height: 44px; }
    .cal-cell { min-height: 38px; font-size: 0.72rem; }
  }
</style>

<script is:inline define:vars={{
  serializedIndex,
  serializedCats,
  serializedMeta,
  serializedYears,
  serializedMonthsByYear,
  serializedWeekdays,
  defaultYear,
}}>
  (function () {
    var index = JSON.parse(serializedIndex);
    var cats = JSON.parse(serializedCats);
    var meta = JSON.parse(serializedMeta);
    var years = JSON.parse(serializedYears);
    var monthsByYear = JSON.parse(serializedMonthsByYear);
    var WEEKDAYS = JSON.parse(serializedWeekdays);

    var OPEN_KEY = 'news-getter:archive-open';

    var root = document.querySelector('[data-archive]');
    if (!root) return;
    var search = root.querySelector('[data-archive-search]');
    var body = root.querySelector('[data-archive-body]');
    var countEl = root.querySelector('[data-result-count]');
    var noResults = root.querySelector('[data-no-results]');
    var detailEl = root.querySelector('[data-day-detail]');
    var yearBtns = Array.from(root.querySelectorAll('[data-year]'));
    var monthRow = root.querySelector('[data-month-pills]');
    var catBtns = Array.from(root.querySelectorAll('[data-cat]'));
    var clearBtn = root.querySelector('[data-clear-filters]');

    var state = { year: defaultYear, month: '', cat: '', q: '', day: '' };

    function loadOpenSet() {
      try {
        var raw = localStorage.getItem(OPEN_KEY);
        return raw ? new Set(JSON.parse(raw)) : new Set();
      } catch (e) { return new Set(); }
    }
    function saveOpenSet(s) {
      try { localStorage.setItem(OPEN_KEY, JSON.stringify(Array.from(s))); } catch (e) {}
    }
    var openSet = loadOpenSet();

    function timeToDir(t) { return t.replace(':', '-'); }
    function unionCats(day) {
      var s = {};
      day.runs.forEach(function (r) { r.categories.forEach(function (c) { s[c] = true; }); });
      return Object.keys(s);
    }
    function latestRunForCat(day, cat) {
      for (var i = day.runs.length - 1; i >= 0; i--) {
        if (day.runs[i].categories.indexOf(cat) !== -1) return day.runs[i].time;
      }
      return meta[day.date].latest;
    }
    function hueFor(name) {
      var hit = cats.find(function (x) { return x.name === name; });
      return hit ? hit.hue : 0;
    }
    function findDay(dateStr) { return index.find(function (d) { return d.date === dateStr; }); }

    function dayMatchesFilters(day) {
      if (state.cat && unionCats(day).indexOf(state.cat) === -1) return false;
      if (state.q) {
        var q = state.q.toLowerCase();
        var dateHit = day.date.toLowerCase().indexOf(q) !== -1;
        var catHit = unionCats(day).some(function (c) { return c.toLowerCase().indexOf(q) !== -1; });
        if (!dateHit && !catHit) return false;
      }
      return true;
    }

    function monthsForYear(y) { return monthsByYear[y] || []; }

    function renderMonthPills() {
      if (!monthRow) return;
      var ms = monthsForYear(state.year);
      var html = '<button class="pill' + (state.month === '' ? ' is-active' : '') + '" type="button" data-month="" aria-pressed="' + (state.month === '') + '">全部</button>';
      ms.forEach(function (m) {
        var label = m.slice(5);
        var on = state.month === m;
        html += '<button class="pill' + (on ? ' is-active' : '') + '" type="button" data-month="' + m + '" aria-pressed="' + on + '">' + label + '</button>';
      });
      monthRow.innerHTML = html;
    }

    function renderCalendar(m) {
      var year = parseInt(m.slice(0, 4), 10);
      var month = parseInt(m.slice(5), 10);
      var firstWd = new Date(Date.UTC(year, month - 1, 1)).getUTCDay();
      var dim = new Date(Date.UTC(year, month, 0)).getUTCDate();

      var daysInMonth = [];
      for (var d = 1; d <= dim; d++) {
        var ds = m + '-' + (d < 10 ? '0' + d : d);
        daysInMonth.push({ ds: ds, d: d, hasData: !!meta[ds] });
      }

      var sec = document.createElement('section');
      sec.className = 'month-section';
      sec.setAttribute('data-month-key', m);

      var matchingDays = daysInMonth.filter(function (x) { return x.hasData && dayMatchesFilters(findDay(x.ds)); });
      var runCount = matchingDays.reduce(function (a, x) { return a + findDay(x.ds).runs.length; }, 0);

      var head = document.createElement('div');
      head.className = 'month-head';
      head.setAttribute('data-toggle', m);
      var left = document.createElement('div');
      left.className = 'month-head-left';
      var chev = document.createElement('span');
      chev.className = 'month-chevron';
      chev.textContent = '▾';
      var label = document.createElement('h3');
      label.className = 'month-label';
      label.textContent = m;
      left.appendChild(chev);
      left.appendChild(label);
      var cnt = document.createElement('span');
      cnt.className = 'month-count';
      cnt.textContent = matchingDays.length + ' 天 · ' + runCount + ' 次 run';
      head.appendChild(left);
      head.appendChild(cnt);
      sec.appendChild(head);

      var mbody = document.createElement('div');
      mbody.className = 'month-body';

      var grid = document.createElement('div');
      grid.className = 'cal-grid';
      WEEKDAYS.forEach(function (w) {
        var dow = document.createElement('div');
        dow.className = 'cal-dow';
        dow.textContent = w;
        grid.appendChild(dow);
      });
      for (var b = 0; b < firstWd; b++) {
        var blank = document.createElement('div');
        blank.className = 'cal-cell cal-blank';
        grid.appendChild(blank);
      }
      daysInMonth.forEach(function (x) {
        var cell = document.createElement('div');
        if (!x.hasData) {
          cell.className = 'cal-cell cal-empty';
          cell.textContent = x.d;
          grid.appendChild(cell);
          return;
        }
        var day = findDay(x.ds);
        var filteredOut = !dayMatchesFilters(day);
        var selected = state.day === x.ds;
        cell.className = 'cal-cell has-data' + (filteredOut ? ' filtered-out' : '') + (selected ? ' is-selected' : '');
        cell.setAttribute('data-date', x.ds);
        cell.setAttribute('role', 'button');
        cell.setAttribute('tabindex', '0');
        if (day.runs.length > 1) {
          var rn = document.createElement('span');
          rn.className = 'cal-runs';
          rn.textContent = '×' + day.runs.length;
          cell.appendChild(rn);
        }
        var num = document.createElement('span');
        num.className = 'cal-num';
        num.textContent = x.d;
        cell.appendChild(num);
        var dot = document.createElement('span');
        dot.className = 'cal-dot';
        cell.appendChild(dot);
        grid.appendChild(cell);
      });
      mbody.appendChild(grid);
      sec.appendChild(mbody);

      applyOpenState(sec, m, matchingDays.length);
      return sec;
    }

    function applyOpenState(sec, m, matchingCount) {
      var filtering = state.cat !== '' || state.q !== '';
      if (filtering && matchingCount > 0) {
        sec.classList.add('is-open', 'force-open');
      } else if (filtering) {
        sec.classList.remove('is-open', 'force-open');
      } else {
        sec.classList.remove('force-open');
        sec.classList.toggle('is-open', openSet.has(m));
      }
    }

    function renderDetail() {
      if (!state.day || !meta[state.day]) {
        detailEl.hidden = true;
        detailEl.innerHTML = '';
        return;
      }
      var day = findDay(state.day);
      if (!day) { detailEl.hidden = true; return; }
      var dm = meta[state.day];
      var dayCats = unionCats(day);
      if (state.cat) dayCats = dayCats.filter(function (c) { return c === state.cat; });
      dayCats.sort();

      var html = '';
      html += '<div class="day-detail-head">';
      html += '<div class="day-detail-date">';
      html += '<span class="dd-num">' + state.day + '</span>';
      html += '<span class="dd-wd">' + dm.weekday + '</span>';
      html += '</div>';
      html += '<span class="day-detail-runs">' + dm.runs + ' 次 run · ' + dayCats.length + ' 類別</span>';
      html += '</div>';
      html += '<div class="day-detail-chips">';
      dayCats.forEach(function (c) {
        var h = hueFor(c);
        var anchor = c.replace(/\s+/g, '-');
        var t = latestRunForCat(day, c);
        html += '<a class="chip" style="--h:' + h + '" href="history/' + state.day + '_' + timeToDir(t) + '/index.html#' + anchor + '">';
        html += '<span class="cat-dot" style="--h:' + h + '" aria-hidden="true"></span>';
        html += c;
        html += '</a>';
      });
      html += '</div>';
      html += '<a class="day-detail-go" href="history/' + state.day + '_' + timeToDir(dm.latest) + '/index.html">前往最新 run →</a>';
      detailEl.innerHTML = html;
      detailEl.hidden = false;
    }

    function render() {
      renderMonthPills();
      body.innerHTML = '';

      var months = state.month ? [state.month] : monthsForYear(state.year);
      var sections = [];
      months.forEach(function (m) {
        var sec = renderCalendar(m);
        body.appendChild(sec);
        sections.push(sec);
      });

      var anyMatching = false;
      index.forEach(function (d) {
        if (d.date.slice(0, 4) !== state.year) return;
        if (state.month && d.date.slice(0, 7) !== state.month) return;
        if (dayMatchesFilters(d)) anyMatching = true;
      });

      renderDetail();

      countEl.textContent = countMatchingDays() + ' / ' + index.length + ' 天';
      noResults.hidden = anyMatching;
      body.hidden = !anyMatching;
      detailEl.hidden = detailEl.hidden || !anyMatching;
    }

    function countMatchingDays() {
      var n = 0;
      index.forEach(function (d) {
        if (d.date.slice(0, 4) !== state.year) return;
        if (state.month && d.date.slice(0, 7) !== state.month) return;
        if (dayMatchesFilters(d)) n++;
      });
      return n;
    }

    function syncHash() {
      var parts = [];
      if (state.year) parts.push('year=' + encodeURIComponent(state.year));
      if (state.month) parts.push('month=' + encodeURIComponent(state.month));
      if (state.cat) parts.push('cat=' + encodeURIComponent(state.cat));
      if (state.q) parts.push('q=' + encodeURIComponent(state.q));
      if (state.day) parts.push('day=' + encodeURIComponent(state.day));
      var hash = parts.length ? '#' + parts.join('&') : '';
      history.replaceState(null, '', hash || window.location.pathname + window.location.search);
    }
    function loadHash() {
      var y = /year=([^&]*)/.exec(window.location.hash);
      var m = /month=([^&]*)/.exec(window.location.hash);
      var c = /cat=([^&]*)/.exec(window.location.hash);
      var q = /q=([^&]*)/.exec(window.location.hash);
      var dy = /day=([^&]*)/.exec(window.location.hash);
      if (y && years.indexOf(decodeURIComponent(y[1])) !== -1) state.year = decodeURIComponent(y[1]);
      else state.year = defaultYear;
      state.month = m ? decodeURIComponent(m[1]) : '';
      state.cat = c ? decodeURIComponent(c[1]) : '';
      state.q = q ? decodeURIComponent(q[1]) : '';
      state.day = dy ? decodeURIComponent(dy[1]) : '';
      if (search) search.value = state.q;
    }

    function setPillActive(btns, attr, val) {
      btns.forEach(function (b) {
        var v = b.getAttribute('data-' + attr) || '';
        var on = v === val;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
    }

    function applyState() {
      setPillActive(yearBtns, 'year', state.year);
      setPillActive(catBtns, 'cat', state.cat);
      render();
      syncHash();
    }

    yearBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        state.year = b.getAttribute('data-year') || '';
        state.month = '';
        state.day = '';
        applyState();
      });
    });
    catBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        state.cat = b.getAttribute('data-cat') || '';
        applyState();
      });
    });
    if (search) {
      search.addEventListener('input', function () {
        state.q = search.value;
        applyState();
      });
    }
    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        state.cat = ''; state.q = ''; state.day = '';
        if (search) search.value = '';
        applyState();
      });
    }

    body.addEventListener('click', function (e) {
      var tog = e.target.closest('[data-toggle]');
      if (tog) {
        var m = tog.getAttribute('data-toggle');
        var filtering = state.cat !== '' || state.q !== '';
        if (filtering) return;
        if (openSet.has(m)) openSet.delete(m); else openSet.add(m);
        saveOpenSet(openSet);
        var sec = tog.closest('.month-section');
        if (sec) sec.classList.toggle('is-open', openSet.has(m));
        return;
      }
      var cell = e.target.closest('.cal-cell.has-data');
      if (cell) {
        state.day = cell.getAttribute('data-date');
        var mk = cell.closest('.month-section');
        var mkey = mk ? mk.getAttribute('data-month-key') : '';
        if (mkey && !openSet.has(mkey)) {
          openSet.add(mkey);
          saveOpenSet(openSet);
          if (mk) mk.classList.add('is-open');
        }
        applyState();
      }
    });
    body.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      var cell = e.target.closest('.cal-cell.has-data');
      if (!cell) return;
      e.preventDefault();
      state.day = cell.getAttribute('data-date');
      applyState();
    });

    monthRow.addEventListener('click', function (e) {
      var b = e.target.closest('[data-month]');
      if (!b) return;
      state.month = b.getAttribute('data-month') || '';
      state.day = '';
      applyState();
    });

    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (search) search.focus();
      }
    });

    loadHash();
    applyState();
  })();
</script>